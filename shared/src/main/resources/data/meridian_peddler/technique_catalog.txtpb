# 千里腿功法目录。所有数值均为占位，做功按两腿六块肌肉的合计功率平均分配。
schema_version: 1
namespace: "meridian_peddler"
binding_template_groups: "human:humanoid"
books {
  id: "meridian_peddler:legwork"
  display_name: "千里腿"
  leg_rules {
    ignore_held_items: true
    require_grounded: false
    base_damage { value: 2 unit: DAMAGE_POINT }
    armor_damage { value: 0.5 unit: DAMAGE_POINT }
    durability_cost: 1
  }
}
volumes {
  id: "meridian_peddler:road"
  book_id: "meridian_peddler:legwork"
  display_name: "上卷·赶路"
  techniques { id: "meridian_peddler:snap_kick" version: 1 }
  techniques { id: "meridian_peddler:push_kick" version: 1 }
  techniques { id: "meridian_peddler:ground_sweep" version: 1 }
  techniques { id: "meridian_peddler:horse_stance" version: 1 }
  # 生存来源：玩家亲手杀死会这一卷的流浪商人（Threatening 学卷表的游炁、真炁两档）时掉一卷，概率占位。
  scroll_drops { entity_type: "minecraft:wandering_trader" chance: 0.25 }
}
volumes {
  id: "meridian_peddler:ambush"
  book_id: "meridian_peddler:legwork"
  display_name: "中卷·拦路"
  techniques { id: "meridian_peddler:roundhouse" version: 1 }
  techniques { id: "meridian_peddler:triple_kick" version: 1 }
  techniques { id: "meridian_peddler:mule_kick" version: 1 }
  prerequisite_volume_ids: "meridian_peddler:road"
  # 生存来源同上卷；学卷表里只有真炁流浪商人会中卷。
  scroll_drops { entity_type: "minecraft:wandering_trader" chance: 0.25 }
}
volumes {
  id: "meridian_peddler:journey"
  book_id: "meridian_peddler:legwork"
  display_name: "下卷·千里"
  techniques { id: "meridian_peddler:flying_kick" version: 1 }
  techniques { id: "meridian_peddler:axe_kick" version: 1 }
  techniques { id: "meridian_peddler:whirlwind" version: 1 }
  prerequisite_volume_ids: "meridian_peddler:ambush"
  # 生存来源同上卷；学卷表里只有一成真炁流浪商人会下卷，所以下卷最难得。
  scroll_drops { entity_type: "minecraft:wandering_trader" chance: 0.25 }
}

definitions {
  id: "meridian_peddler:snap_kick"
  version: 1
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 3 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    combat {
      target_airborne_weight { value: 0.5 unit: RATIO }
      target_behind_weight { value: 0 unit: RATIO }
      minimum_leg_force { value: 3000 unit: NEWTON }
    }
  }
  category: ATTACK
  minimum_realm: WANDERING_QI
  slots {
    id: "foot_meridians"
    module: MERIDIAN
    tags: "human:foot_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  slots {
    id: "leg_muscles"
    module: TISSUE
    tags: "human:leg_muscle"
    minimum_count: 6
    maximum_count: 6
  }
  cost {
    qi {
      slot_id: "foot_meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 3 unit: QI }
      distribution: EVEN
    }
    work {
      slot_id: "leg_muscles"
      force { value: 0 unit: NEWTON }
      power { value: 66.66666666666667 unit: WATT }
      duration { value: 0.3 unit: SECOND }
    }
  }
  phases {
    warmup_millis: 1050
    active_millis: 0
    recovery_millis: 1150
    interruptible_by_damage: false
  }
  cooldown_millis: 1000
  effects {
    at_millis: 0
    presentation {
      id: "meridian_peddler:peddler_snap_kick"
      duration: UNTIL_RECOVERY_END
      start_millis: 0
    }
  }
  effects {
    at_millis: 1050
    leg_strike {
      shape: SINGLE_TARGET
      facing: STRIKE_FORWARD
      distance { value: 2.5 unit: METER }
      angle { value: 60 unit: DEGREE }
      multiplier { value: 1.2 unit: RATIO }
      maximum_targets: 1
      cast_target_limit: 1
      leg: FRONT_LEG
      damage_type_id: "meridian_peddler:kick_lead_legs"
      knockback_kind: PUSH
      knockback { value: 0.2 unit: RATIO }
      knockback_when_blocked: true
      last_strike: true
      dedup_group: "snap_kick"
    }
  }
  presentation { icon_id: "meridian_peddler:snap_kick" display_name: "弹腿" description: "村童们聚在打谷场上，单脚立定，小腿飞快往前虚踢，比谁踢落的草叶多，笑闹着叫这“货郎踢”。直到某天夜里村口进了僵尸，巡夜人照猫画虎踢折了僵尸的小腿骨，大人们才知这不是闹着玩。" }
  movement_speed_multiplier: 0.4
}

